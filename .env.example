# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=your_session_secret_key_here

# Database Configuration
MONGO_DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/rahal?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS & Client URLs
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173
FRONTEND_PROD_URL=https://rahal.app
DASHBOARD_PROD_URL=https://dashboard.rahal.app

# Google OAuth Credentials (Web & Mobile Native)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_MOBILE_CLIENT_ID=your_google_mobile_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com

# Stripe Payments (Checkout Sessions & Native In-App PaymentSheet)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET_BOOKING=whsec_your_booking_webhook_secret
STRIPE_WEBHOOK_SECRET_SUBSCRIPTION=whsec_your_subscription_webhook_secret
STRIPE_PRICE_ID_PRO=price_your_stripe_pro_monthly_price_id
RAHAL_LOGO_URL=https://res.cloudinary.com/rahal/image/upload/logo.png

# Booking Configuration
HOLD_TTL_MINUTES=15

# AI & LLM Services
NVIDIA_API_KEY=nvapi-your_nvidia_api_key
OPENAI_API_KEY=sk-your_openai_api_key

# Vector Database (Pinecone / Upstash)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=rahal
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Delivery (SMTP / Nodemailer)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="Rahal Support <support@rahal.app>"
