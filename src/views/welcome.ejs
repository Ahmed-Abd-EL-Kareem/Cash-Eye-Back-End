<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Welcome to AI Financial Advisor</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: #fff;
    "
  >
    <table width="100%" cellpadding="0" cellspacing="0" style="padding: 40px 0">
      <tr>
        <td align="center">
          <table
            width="600"
            style="background: #111827; border-radius: 12px; padding: 30px"
          >
            <!-- Logo -->
            <tr>
              <td align="center" style="padding-bottom: 20px">
                <h1
                  style="
                    margin: 0;
                    font-size: 28px;
                    background: linear-gradient(90deg, #3b82f6, #22c55e);
                    -webkit-background-clip: text;
                    color: transparent;
                  "
                >
                  AI Financial Advisor
                </h1>
              </td>
            </tr>

            <!-- Title -->
            <tr>
              <td align="center">
                <h2 style="margin: 10px 0">Welcome, <%= name %> 👋</h2>
                <p style="color: #9ca3af">
                  Your smart financial assistant is ready.
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 20px 0">
                <p style="line-height: 1.6; color: #d1d5db">
                  You’ve just joined a new way of managing your business
                  finances.
                </p>

                <ul style="color: #d1d5db">
                  <li>📊 Analyze your expenses instantly</li>
                  <li>📈 Forecast your profits</li>
                  <li>⚠️ Detect financial risks</li>
                  <li>🤖 Get AI-powered recommendations</li>
                </ul>
              </td>
            </tr>

            <!-- CTA -->
            <tr>
              <td align="center" style="padding: 20px 0">
                <a
                  href="<%= dashboardUrl %>"
                  style="
                    background: linear-gradient(90deg, #3b82f6, #22c55e);
                    color: #fff;
                    padding: 12px 24px;
                    border-radius: 8px;
                    text-decoration: none;
                    font-weight: bold;
                  "
                >
                  Go to Dashboard
                </a>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="padding-top: 20px; font-size: 12px; color: #6b7280"
              >
                © <%= year %> AI Financial Advisor — All rights reserved
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
