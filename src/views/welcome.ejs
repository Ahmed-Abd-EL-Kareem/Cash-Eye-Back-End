<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <title>Welcome to Rahal</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: #fff;
    "
  >
    <table width="100%" cellpadding="0" cellspacing="0" style="padding: 40px 0">
      <tr>
        <td align="center">
          <table
            width="600"
            style="background: #111827; border-radius: 12px; padding: 30px"
          >
            <tr>
              <td align="center" style="padding-bottom: 20px">
                <h1
                  style="
                    margin: 0;
                    font-size: 28px;
                    background: linear-gradient(90deg, #f59e0b, #10b981);
                    -webkit-background-clip: text;
                    color: transparent;
                  "
                >
                  🌍 Rahal | رحال
                </h1>
                <p style="color: #6b7280; margin: 4px 0 0; font-size: 13px">
                  Smart AI Travel Planner for Egypt
                </p>
              </td>
            </tr>
            <tr>
              <td align="center">
                <h2 style="margin: 10px 0">Welcome, <%= name %> 👋</h2>
                <p style="color: #9ca3af">
                  Your AI travel companion for Egypt is ready.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding: 20px 0">
                <p style="line-height: 1.6; color: #d1d5db">
                  You've just joined the smartest way to explore Egypt.
                </p>
                <ul style="color: #d1d5db; padding-left: 20px">
                  <li style="margin-bottom: 8px">
                    🗺️ Generate AI travel itineraries
                  </li>
                  <li style="margin-bottom: 8px">
                    🏨 Browse hotels across Egypt
                  </li>
                  <li style="margin-bottom: 8px">
                    🤖 Chat with your AI travel guide
                  </li>
                  <li style="margin-bottom: 8px">
                    💾 Save and manage your trips
                  </li>
                </ul>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 20px 0">
                <a
                  href="<%= dashboardUrl %>"
                  style="
                    background: linear-gradient(90deg, #f59e0b, #10b981);
                    color: #fff;
                    padding: 12px 28px;
                    border-radius: 8px;
                    text-decoration: none;
                    font-weight: bold;
                    font-size: 15px;
                  "
                >
                  Start Planning Your Trip
                </a>
              </td>
            </tr>
            <tr>
              <td
                align="center"
                style="padding-top: 20px; font-size: 12px; color: #6b7280"
              >
                © <%= year %> Rahal | رحال — All rights reserved
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
